# Neon Postgres
# Local `.env`: connection string for the **dev** branch (direct is best so schema push works).
# Netlify: pooled URL for the **prod** branch in DATABASE_URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Optional. Direct/non-pooled URL used by `pnpm migrate`. Falls back to DATABASE_URL.
DATABASE_MIGRATE_URL=

# Payload
PAYLOAD_SECRET=CHANGE_ME
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Email (Resend). When unset, auth and submission emails log to the server console instead.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Spector Craft Prize
# Published Resend template IDs or aliases. Variables: VERIFY_URL / RESET_URL.
# When unset, the app falls back to inline HTML emails.
RESEND_TEMPLATE_VERIFY_EMAIL=verify-email
RESEND_TEMPLATE_RESET_PASSWORD=reset-password

# Cloudflare R2 (S3-compatible). Public URL is the r2.dev subdomain or a custom domain, not the S3 API endpoint.
R2_BUCKET=spector-craft-prize-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev
# Private bucket for portal uploads (work images, videos, government IDs). Never enable public access on it.
R2_SUBMISSIONS_BUCKET=spector-craft-prize-submissions
